<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape: zoom in top-left, zoom out bottom-left, menu top-right. Nothing else on the picture. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Immagine ingrandita. Pizzica per lo zoom, tocca per mettere a fuoco, doppio tocco per leggere il testo." />

    <it.squaregen.lente.ZoomImageView
        android:id="@+id/frozen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:contentDescription="Immagine ferma. Pizzica per ingrandire, trascina per spostarti, doppio tocco per leggere il testo."
        android:visibility="gone" />

    <!-- Reading guide: darkens everything except a horizontal band (as on desktop video magnifiers). -->
    <View
        android:id="@+id/maskTop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="#E6000000"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <View
        android:id="@+id/maskBottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="#E6000000"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- Only for problems (e.g. camera not available). -->
    <TextView
        android:id="@+id/bigLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="24dp"
        android:background="@drawable/chip_bg"
        android:gravity="center"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:textColor="@color/fg"
        android:textSize="26sp"
        android:textStyle="bold"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/btnZoomOut"
        style="@style/RoundButton"
        android:layout_gravity="bottom|start"
        android:contentDescription="Riduci lo zoom"
        android:src="@drawable/ic_minus" />

    <ImageView
        android:id="@+id/btnZoomIn"
        style="@style/RoundButton"
        android:layout_gravity="top|start"
        android:contentDescription="Aumenta lo zoom"
        android:src="@drawable/ic_plus" />

    <ImageView
        android:id="@+id/btnMenu"
        style="@style/RoundButton"
        android:layout_gravity="top|end"
        android:contentDescription="Menu"
        android:src="@drawable/ic_menu" />

    <!-- Menu: opens on the right; tapping the picture on the left closes it. -->
    <ScrollView
        android:id="@+id/menuPanel"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="#F5000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/menuContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="16dp" />
    </ScrollView>

    <!-- Shown when the camera permission is missing. -->
    <LinearLayout
        android:id="@+id/permissionPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:text="Per ingrandire serve la fotocamera."
            android:textColor="@color/fg"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/big_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="80dp"
            android:text="Consenti la fotocamera"
            android:textColor="@color/fg"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
