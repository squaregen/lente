<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Immagine della fotocamera ingrandita. Pizzica per lo zoom, tocca per mettere a fuoco." />

    <it.squaregen.lente.ZoomImageView
        android:id="@+id/frozen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:contentDescription="Immagine ferma. Pizzica per ingrandire, trascina per spostarti."
        android:visibility="gone" />

    <!-- Reading guide: darkens everything except a horizontal band (as on desktop video magnifiers). -->
    <View
        android:id="@+id/maskTop"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="top"
        android:background="#E6000000"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <View
        android:id="@+id/maskBottom"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="bottom"
        android:background="#E6000000"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- Short-lived big message (zoom level, colour mode name...). -->
    <TextView
        android:id="@+id/bigLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="56dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/chip_bg"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:textColor="@color/fg"
        android:textSize="40sp"
        android:textStyle="bold"
        android:accessibilityLiveRegion="polite"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textChip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/chip_bg"
            android:drawableStart="@drawable/ic_text"
            android:drawablePadding="14dp"
            android:gravity="center_vertical"
            android:minHeight="80dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Testo trovato: tocca qui per leggerlo grande"
            android:textColor="@color/fg"
            android:textSize="22sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#D9000000"
            android:orientation="vertical"
            android:paddingStart="6dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnZoomOut"
                    style="@style/BigButton"
                    android:layout_width="80dp"
                    android:layout_weight="0"
                    android:contentDescription="Riduci lo zoom"
                    android:drawableTop="@drawable/ic_minus"
                    android:text="Meno" />

                <SeekBar
                    android:id="@+id/zoomBar"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_weight="1"
                    android:contentDescription="Livello di zoom"
                    android:max="1000"
                    android:maxHeight="14dp"
                    android:minHeight="14dp"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp"
                    android:progressDrawable="@drawable/seek_track"
                    android:splitTrack="false"
                    android:thumb="@drawable/seek_thumb" />

                <TextView
                    android:id="@+id/btnZoomIn"
                    style="@style/BigButton"
                    android:layout_width="80dp"
                    android:layout_weight="0"
                    android:contentDescription="Aumenta lo zoom"
                    android:drawableTop="@drawable/ic_plus"
                    android:text="Più" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnLight"
                    style="@style/BigButton"
                    android:drawableTop="@drawable/ic_light"
                    android:text="Luce" />

                <TextView
                    android:id="@+id/btnColors"
                    style="@style/BigButton"
                    android:drawableTop="@drawable/ic_contrast"
                    android:text="Colori" />

                <TextView
                    android:id="@+id/btnFreeze"
                    style="@style/BigButton"
                    android:drawableTop="@drawable/ic_pause"
                    android:text="Ferma" />

                <TextView
                    android:id="@+id/btnRead"
                    style="@style/BigButton"
                    android:drawableTop="@drawable/ic_text"
                    android:text="Leggi" />

                <TextView
                    android:id="@+id/btnMore"
                    style="@style/BigButton"
                    android:drawableTop="@drawable/ic_menu"
                    android:text="Altro" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- "Altro" menu: filled in from code. -->
    <ScrollView
        android:id="@+id/morePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F2000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/moreContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="24dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp" />
    </ScrollView>

    <!-- Shown when the camera permission is missing. -->
    <LinearLayout
        android:id="@+id/permissionPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            android:text="Per ingrandire serve la fotocamera."
            android:textColor="@color/fg"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnPermission"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/big_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="96dp"
            android:text="Consenti la fotocamera"
            android:textColor="@color/fg"
            android:textSize="26sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
